\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Figure 2}. Temporal and overall importance of species attributes for predicting pollinator visitation rates. Relative importance of species attributes estimated from random forest models using SHAP (SHapley Additive exPlanations) values. (a) Weekly variation in the relative contribution of each predictor to model predictions across the flowering season. Values were estimated using sliding-window random forest models fitted over 5-week intervals and assigned to the central week of each window. (b) Overall importance of each predictor summarized as the mean SHAP value across all weeks.}}{9}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:unnamed-chunk-1}{{1}{9}{\textbf {Figure 2}. Temporal and overall importance of species attributes for predicting pollinator visitation rates. Relative importance of species attributes estimated from random forest models using SHAP (SHapley Additive exPlanations) values. (a) Weekly variation in the relative contribution of each predictor to model predictions across the flowering season. Values were estimated using sliding-window random forest models fitted over 5-week intervals and assigned to the central week of each window. (b) Overall importance of each predictor summarized as the mean SHAP value across all weeks}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Figure 3}. Procrustes association between visitation rate and plant-pollinator interaction probability matrices derived from abundance (a), trait matching (b), and phenology (c) across levels of temporal resolution (weekly, weekly aggregated, and full season), while accounting for variability among botanical gardens. Weekly aggregated values correspond to three seasonal categories (early, mid, and late), obtained by pooling weekly networks into three equal temporal partitions of the full sampling period. Weekly values represent individual weekly networks within each seasonal category. Solid lines and points represent mean Procrustes associations for weekly networks across botanical gardens, whereas dashed and dotted horizontal lines indicate weekly aggregated seasonal networks and full-season networks, respectively. Shaded areas and error bars indicate the minimum-maximum range among botanical gardens.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:unnamed-chunk-2}{{2}{11}{\textbf {Figure 3}. Procrustes association between visitation rate and plant-pollinator interaction probability matrices derived from abundance (a), trait matching (b), and phenology (c) across levels of temporal resolution (weekly, weekly aggregated, and full season), while accounting for variability among botanical gardens. Weekly aggregated values correspond to three seasonal categories (early, mid, and late), obtained by pooling weekly networks into three equal temporal partitions of the full sampling period. Weekly values represent individual weekly networks within each seasonal category. Solid lines and points represent mean Procrustes associations for weekly networks across botanical gardens, whereas dashed and dotted horizontal lines indicate weekly aggregated seasonal networks and full-season networks, respectively. Shaded areas and error bars indicate the minimum-maximum range among botanical gardens}{figure.caption.7}{}}
\BKM@entry{id=5,dest={73656374696F6E2A2E39},srcline={669}}{5C3337365C3337375C303030445C303030695C303030735C303030635C303030755C303030735C303030735C303030695C3030306F5C3030306E}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Figure 4}. Standardized effect sizes (SES) of plant-pollinator interactions relative to null expectations derived from week- and garden-specific randomizations. Colours denote deviation from null expectations (avoidance, no difference, preference). a, Distribution of SES values across all plant-pollinator genus pairs; dashed lines indicate critical values (±1.96) b, Interaction patterns at the plant family × pollinator guild level for the 18 plant families with the strongest overall SES signal (sum of absolute SES values). Numbers in parentheses indicate species richness for each pollinator guild (y axis) and plant family (x axis).}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:unnamed-chunk-3}{{3}{12}{\textbf {Figure 4}. Standardized effect sizes (SES) of plant-pollinator interactions relative to null expectations derived from week- and garden-specific randomizations. Colours denote deviation from null expectations (avoidance, no difference, preference). a, Distribution of SES values across all plant-pollinator genus pairs; dashed lines indicate critical values (±1.96) b, Interaction patterns at the plant family × pollinator guild level for the 18 plant families with the strongest overall SES signal (sum of absolute SES values). Numbers in parentheses indicate species richness for each pollinator guild (y axis) and plant family (x axis)}{figure.caption.8}{}}
